# LLM provider: gemini | ollama | none
NUXT_LLM_PROVIDER=gemini

# Free key from Google AI Studio: https://aistudio.google.com/apikey
NUXT_GEMINI_API_KEY=
NUXT_GEMINI_MODEL=gemini-2.5-flash

# Optional local alternative
NUXT_OLLAMA_URL=http://localhost:11434
NUXT_OLLAMA_MODEL=llama3.1

# Public site settings (used for canonical URLs, sitemap, JSON-LD)
NUXT_PUBLIC_SITE_URL=http://localhost:3000
NUXT_PUBLIC_SITE_NAME=Industry Rankings
